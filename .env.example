# Configure one matching REST URL/token pair for persistent, per-browser collections.
# The Vercel KV integration may supply KV_REST_API_URL and KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Generate a long, random value and keep it stable across deployments.
NUXT_SESSION_SECRET=
